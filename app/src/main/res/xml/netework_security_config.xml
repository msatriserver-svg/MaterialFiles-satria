<?xml version="1.0" encoding="utf-8"?>

<!-- Satria build: the app only speaks SSH; no cleartext HTTP, no user-installed CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
